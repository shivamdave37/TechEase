rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // 1. User Profiles: Only owner can read/write their own full profile
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isAdmin();
    }

    // 2. Learning Categories & Lessons: Read-only for public, write for admin
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
      
      match /tasks/{taskId} {
        allow read: if true;
        allow write: if isAdmin();
        
        match /lessons/{lessonId} {
          allow read: if true;
          allow write: if isAdmin();
        }
      }
    }

    // 3. User Progress & Bookmarks: Private to the authenticated learner
    match /users/{userId}/progress/{lessonId} {
      allow read, write: if isOwner(userId);
    }
    match /users/{userId}/bookmarks/{lessonId} {
      allow read, write: if isOwner(userId);
    }

    // 4. Community Videos:
    // - Approved videos are readable by any authenticated user
    // - Submissions can be created by authenticated users (status must start as 'pending')
    // - Only admin can update status to 'approved' or 'rejected'
    match /community_videos/{videoId} {
      allow read: if resource.data.status == 'approved' || isOwner(resource.data.uploaderId) || isAdmin();
      allow create: if isAuthenticated() 
                    && request.resource.data.uploaderId == request.auth.uid 
                    && request.resource.data.status == 'pending';
      allow update: if (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['helpfulCount', 'reportsCount']))
                    || isAdmin();
      allow delete: if isAdmin() || isOwner(resource.data.uploaderId);
    }

    // 5. Voice Groups & Async Voice Messages:
    // - Group details are readable by group members
    // - Phone numbers must never be exposed publicly
    match /voice_groups/{groupId} {
      allow read: if isAuthenticated() && (request.auth.uid in resource.data.memberIds || resource.data.isPublic == true);
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (request.auth.uid == resource.data.creatorId || isAdmin());
      allow delete: if isAuthenticated() && (request.auth.uid == resource.data.creatorId || isAdmin());

      match /messages/{messageId} {
        allow read: if isAuthenticated() && (request.auth.uid in get(/databases/$(database)/documents/voice_groups/$(groupId)).data.memberIds);
        allow create: if isAuthenticated() && (request.auth.uid in get(/databases/$(database)/documents/voice_groups/$(groupId)).data.memberIds)
                      && request.resource.data.senderId == request.auth.uid;
        allow delete: if isAuthenticated() && (request.auth.uid == resource.data.senderId || isAdmin());
      }
    }

    // 6. Moderation Queue: Accessible exclusively to admins
    match /moderation_reports/{reportId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }
  }
}
